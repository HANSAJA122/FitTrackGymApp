<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FitTrackGymApp.ViewModels"
             xmlns:models="clr-namespace:FitTrackGymApp.Models"
             x:Class="FitTrackGymApp.Views.PaymentsPage"
             Title="{Binding Title}"
             BackgroundColor="#121212">

    <Grid RowDefinitions="Auto, Auto, *">
        
        <!-- Search Bar -->
        <SearchBar Grid.Row="0" 
                   Placeholder="Search by member or status..." 
                   Text="{Binding SearchText}"
                   TextColor="White"
                   PlaceholderColor="#AAAAAA"
                   BackgroundColor="#1E1E1E"
                   CancelButtonColor="White"
                   Margin="15,15,15,0" />

        <!-- Add/Edit Form -->
        <Frame Grid.Row="1" BackgroundColor="#1E1E1E" CornerRadius="12" HasShadow="True" BorderColor="Transparent" Padding="15" Margin="15">
            <VerticalStackLayout Spacing="10">
                <Label Text="{Binding FormTitle}" TextColor="White" FontSize="18" FontAttributes="Bold" />
                
                <Picker Title="Select Member" 
                        ItemsSource="{Binding Members}" 
                        ItemDisplayBinding="{Binding FullName}"
                        SelectedItem="{Binding SelectedMember}"
                        TextColor="White" 
                        BackgroundColor="#2C2C2C" />

                <Entry Text="{Binding Amount}" Placeholder="Amount ($)" Keyboard="Numeric" TextColor="White" BackgroundColor="#2C2C2C" />
                
                <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="Payment Date" TextColor="#AAAAAA" FontSize="12" />
                        <DatePicker Date="{Binding PaymentDate}" TextColor="White" BackgroundColor="#2C2C2C" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1">
                        <Label Text="Next Due Date" TextColor="#AAAAAA" FontSize="12" />
                        <DatePicker Date="{Binding NextDueDate}" TextColor="White" BackgroundColor="#2C2C2C" />
                    </VerticalStackLayout>
                </Grid>
                
                <Picker Title="Select Status" 
                        SelectedItem="{Binding Status}"
                        TextColor="White" 
                        BackgroundColor="#2C2C2C">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>Paid</x:String>
                            <x:String>Pending</x:String>
                            <x:String>Overdue</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>
                
                <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,10,0,0">
                    <Button Grid.Column="0" Text="Clear" Command="{Binding ClearFormCommand}" BackgroundColor="#555555" TextColor="White" CornerRadius="8" />
                    <Button Grid.Column="1" Text="Save Payment" Command="{Binding SavePaymentCommand}" BackgroundColor="#4CAF50" TextColor="White" CornerRadius="8" />
                </Grid>
            </VerticalStackLayout>
        </Frame>

        <!-- CollectionView for Payments -->
        <CollectionView Grid.Row="2" ItemsSource="{Binding Payments}" Margin="15,0,15,15" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Payment">
                    <Frame BackgroundColor="#1E1E1E" CornerRadius="12" HasShadow="True" BorderColor="Transparent" Padding="15" Margin="0,0,0,10">
                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="{Binding Member.FullName}" TextColor="White" FontSize="18" FontAttributes="Bold" />
                                <Label Text="{Binding Amount, StringFormat='${0:F2}'}" TextColor="#4CAF50" FontSize="16" FontAttributes="Bold" />
                                <Label Text="{Binding Status}" TextColor="#AAAAAA" FontSize="14" FontAttributes="Bold" />
                                <Label Text="{Binding PaymentDate, StringFormat='Paid on: {0:MMM dd, yyyy}'}" TextColor="#AAAAAA" FontSize="12" Margin="0,5,0,0" />
                                <Label Text="{Binding NextDueDate, StringFormat='Due next: {0:MMM dd, yyyy}'}" TextColor="#AAAAAA" FontSize="12" />
                            </VerticalStackLayout>
                            
                            <VerticalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
                                <Button Text="Edit" 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:PaymentsViewModel}}, Path=EditPaymentCommand}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="#2196F3" 
                                        TextColor="White" 
                                        CornerRadius="5" />
                                <Button Text="Delete" 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:PaymentsViewModel}}, Path=DeletePaymentCommand}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="#F44336" 
                                        TextColor="White" 
                                        CornerRadius="5" />
                            </VerticalStackLayout>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <Label Text="No payments found." TextColor="#AAAAAA" HorizontalOptions="Center" VerticalOptions="Center" />
            </CollectionView.EmptyView>
        </CollectionView>

    </Grid>
</ContentPage>
