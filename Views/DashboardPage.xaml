<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FitTrackGymApp.ViewModels"
             x:Class="FitTrackGymApp.Views.DashboardPage"
             Title="Dashboard"
             BackgroundColor="#121212">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20">
            <Label Text="FitTrack Gym" 
                   FontSize="32" 
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center" />

            <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, *" RowSpacing="15" ColumnSpacing="15">
                
                <!-- Total Members Card -->
                <Frame Grid.Row="0" Grid.Column="0" BackgroundColor="#1E1E1E" CornerRadius="12" HasShadow="True" BorderColor="Transparent" Padding="15">
                    <VerticalStackLayout>
                        <Label Text="Total Members" TextColor="#AAAAAA" FontSize="14"/>
                        <Label Text="{Binding TotalMembers}" TextColor="#4CAF50" FontSize="28" FontAttributes="Bold" Margin="0,5,0,0"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Active Members Card -->
                <Frame Grid.Row="0" Grid.Column="1" BackgroundColor="#1E1E1E" CornerRadius="12" HasShadow="True" BorderColor="Transparent" Padding="15">
                    <VerticalStackLayout>
                        <Label Text="Active Members" TextColor="#AAAAAA" FontSize="14"/>
                        <Label Text="{Binding ActiveMembers}" TextColor="#2196F3" FontSize="28" FontAttributes="Bold" Margin="0,5,0,0"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Pending Payments Card -->
                <Frame Grid.Row="1" Grid.Column="0" BackgroundColor="#1E1E1E" CornerRadius="12" HasShadow="True" BorderColor="Transparent" Padding="15">
                    <VerticalStackLayout>
                        <Label Text="Pending Payments" TextColor="#AAAAAA" FontSize="14"/>
                        <Label Text="{Binding PendingPayments}" TextColor="#F44336" FontSize="28" FontAttributes="Bold" Margin="0,5,0,0"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Today Check-ins Card -->
                <Frame Grid.Row="1" Grid.Column="1" BackgroundColor="#1E1E1E" CornerRadius="12" HasShadow="True" BorderColor="Transparent" Padding="15">
                    <VerticalStackLayout>
                        <Label Text="Today Check-ins" TextColor="#AAAAAA" FontSize="14"/>
                        <Label Text="45" TextColor="#FF9800" FontSize="28" FontAttributes="Bold" Margin="0,5,0,0"/>
                    </VerticalStackLayout>
                </Frame>

            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
