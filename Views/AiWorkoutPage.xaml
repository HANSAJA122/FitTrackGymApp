<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FitTrackGymApp.ViewModels"
             x:Class="FitTrackGymApp.Views.AiWorkoutPage"
             Title="{Binding Title}"
             BackgroundColor="#121212">

    <ScrollView>
        <VerticalStackLayout Padding="15" Spacing="20">
            
            <Label Text="AI Workout Generator" TextColor="White" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" />
            <Label Text="Tell the AI about yourself to get a custom workout plan." TextColor="#AAAAAA" HorizontalOptions="Center" HorizontalTextAlignment="Center" />

            <!-- Input Form -->
            <Frame BackgroundColor="#1E1E1E" CornerRadius="12" HasShadow="True" BorderColor="Transparent" Padding="15">
                <VerticalStackLayout Spacing="15">
                    
                    <VerticalStackLayout>
                        <Label Text="Your Goal" TextColor="#AAAAAA" FontSize="12" />
                        <Picker ItemsSource="{Binding Goals}" SelectedItem="{Binding SelectedGoal}" Title="Select Goal" TextColor="White" BackgroundColor="#2C2C2C" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Age (12-80)" TextColor="#AAAAAA" FontSize="12" />
                            <Entry Text="{Binding Age}" Keyboard="Numeric" Placeholder="e.g. 25" TextColor="White" BackgroundColor="#2C2C2C" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Days / Week" TextColor="#AAAAAA" FontSize="12" />
                            <Picker ItemsSource="{Binding DaysOptions}" SelectedItem="{Binding SelectedDays}" Title="Days" TextColor="White" BackgroundColor="#2C2C2C" />
                        </VerticalStackLayout>
                    </Grid>

                    <VerticalStackLayout>
                        <Label Text="Experience Level" TextColor="#AAAAAA" FontSize="12" />
                        <Picker ItemsSource="{Binding ExperienceLevels}" SelectedItem="{Binding SelectedExperience}" Title="Select Level" TextColor="White" BackgroundColor="#2C2C2C" />
                    </VerticalStackLayout>

                    <Button Text="Generate Plan" 
                            Command="{Binding GenerateCommand}" 
                            BackgroundColor="#9C27B0" 
                            TextColor="White" 
                            CornerRadius="8" 
                            FontAttributes="Bold"
                            Margin="0,10,0,0"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Loading Indicator -->
            <VerticalStackLayout IsVisible="{Binding IsBusy}" Spacing="10" HorizontalOptions="Center">
                <ActivityIndicator IsRunning="{Binding IsBusy}" Color="#9C27B0" />
                <Label Text="AI is analyzing your profile..." TextColor="#9C27B0" FontSize="14" FontAttributes="Italic" />
            </VerticalStackLayout>

            <!-- Result Card -->
            <Frame IsVisible="{Binding HasResult}" BackgroundColor="#1E1E1E" CornerRadius="12" HasShadow="True" BorderColor="#9C27B0" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <Label Text="✨" FontSize="20" />
                        <Label Text="Your Custom AI Plan" TextColor="#9C27B0" FontSize="18" FontAttributes="Bold" />
                    </HorizontalStackLayout>
                    
                    <BoxView HeightRequest="1" Color="#333333" />
                    
                    <Label Text="{Binding GeneratedPlan}" TextColor="White" FontSize="15" />
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
